{
    "python.defaultInterpreterPath": ".venv/bin/python",
    "python.venvPath": "${workspaceFolder}/.venv",
    "python.analysis.autoSearchPaths": true,
    "python.analysis.useLibraryCodeForTypes": true,
    "git.showUntrackedFiles": "onlyTracked",
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/*.pyd": true,
        "**/.ipynb_checkpoints": true,
        "data": true,
        "documentation": true
    },
    "cSpell.words": [
        "extsynchro",
        "Inconel",
        "maxtint",
        "MIFASOL",
        "mintint",
        "nbframesperswtrig",
        "ndarray",
        "pcov",
        "perr",
        "popt",
        "scienceplots",
        "skimage",
        "swsynchro",
        "swtrig",
        "Ther",
        "tintstep",
        "xdata",
        "Ximea",
        "xlabel",
        "ydata",
        "ylabel"
    ]
}